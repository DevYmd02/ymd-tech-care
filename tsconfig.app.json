{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    /* Path Aliases */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@core/*": ["./src/core/*"],
      "@shared": ["./src/shared"],
      "@shared/*": ["./src/shared/*"],
      "@components": ["./src/shared/components"],
      "@components/*": ["./src/shared/components/*"],
      "@ui": ["./src/shared/components/ui"],
      "@ui/*": ["./src/shared/components/ui/*"],
      "@layout": ["./src/shared/components/ui/layout"],
      "@layout/*": ["./src/shared/components/ui/layout/*"],
      "@system": ["./src/shared/components/system"],
      "@system/*": ["./src/shared/components/system/*"],
      "@hooks": ["./src/shared/hooks"],
      "@hooks/*": ["./src/shared/hooks/*"],
      "@services": ["./src/services"],
      "@services/*": ["./src/services/*"],
      "@utils": ["./src/shared/utils"],
      "@utils/*": ["./src/shared/utils/*"],
      "@project-types": ["./src/types"],
      "@project-types/*": ["./src/types/*"],
      
      /* Module Aliases */
      "@auth": ["./src/modules/auth"],
      "@auth/*": ["./src/modules/auth/*"],
      "@sales": ["./src/modules/sales"],
      "@sales/*": ["./src/modules/sales/*"],
      "@procurement": ["./src/modules/procurement"],
      "@procurement/*": ["./src/modules/procurement/*"],
      "@pr": ["./src/modules/procurement/pages/pr"],
      "@pr/*": ["./src/modules/procurement/pages/pr/*"],
      "@rfq": ["./src/modules/procurement/pages/rfq"],
      "@rfq/*": ["./src/modules/procurement/pages/rfq/*"],
      "@master-data": ["./src/modules/master-data"],
      "@master-data/*": ["./src/modules/master-data/*"],
      "@customer": ["./src/modules/master-data/customer"],
      "@customer/*": ["./src/modules/master-data/customer/*"],
      "@inventory": ["./src/modules/master-data/inventory"],
      "@inventory/*": ["./src/modules/master-data/inventory/*"],
      "@currency": ["./src/modules/master-data/currency"],
      "@currency/*": ["./src/modules/master-data/currency/*"],
      "@company": ["./src/modules/master-data/company"],
      "@company/*": ["./src/modules/master-data/company/*"]
    }
  },
  "include": ["src"]
}
